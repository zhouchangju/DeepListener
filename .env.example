# DeepListener example environment configuration.
# Copy this file to `.env` and fill in your own values. Never commit your real
# `.env` — it is gitignored. All values below are placeholders.

# ── Database ──────────────────────────────────────────────
# SQLite connection. Prisma resolves this relative to prisma/schema.prisma,
# so the default database file is prisma/dev.db (not the repo-root dev.db).
DATABASE_URL="file:./dev.db"

# ── Transcription provider ───────────────────────────────
# Choose one provider. If unset, the app defaults to "deepgram".
TRANSCRIPTION_PROVIDER=deepgram

# Provide the key for the chosen provider. Only the one you select is used.
DEEPGRAM_API_KEY=your_deepgram_api_key
OPENAI_API_KEY=sk-your_openai_key
GOOGLE_API_KEY=your_google_api_key

# ── Network proxy (optional) ─────────────────────────────
# Set if your network requires a proxy to reach OpenAI / Google.
# HTTPS_PROXY=http://127.0.0.1:7890

# ── Optional: Symphony orchestrator ──────────────────────
# Only needed if you use the Symphony Linear integration.
# LINEAR_API_KEY=your_linear_api_key

# ── Optional: remote sync target (self-hosted deployments) ──
# The npm "sync" / "sync:safe" scripts read these. Leave unset to disable sync.
# SYNC_REMOTE=user@your-server.example.com
# SYNC_REMOTE_BASE=/var/www/DeepListener
