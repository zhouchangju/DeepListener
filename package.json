{
  "name": "deeplistener",
  "version": "0.3.0-alpha.2",
  "private": true,
  "license": "MIT",
  "description": "Local-first, sentence-level English listening trainer with FSRS-4.5 spaced review, multi-provider transcription (OpenAI/Deepgram/Google), waveform-based intensive practice, and shadowing.",
  "keywords": [
    "english-learning",
    "listening",
    "fsrs",
    "spaced-repetition",
    "transcription",
    "wavesurfer",
    "shadowing",
    "self-hosted",
    "local-first",
    "nextjs"
  ],
  "homepage": "https://github.com/zhouchangju/DeepListener",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhouchangju/DeepListener.git"
  },
  "bugs": {
    "url": "https://github.com/zhouchangju/DeepListener/issues"
  },
  "author": "zhouchangju",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/next-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:ci": "node scripts/run-node-tests.mjs",
    "verify": "npm run lint && npm run test:ci && npm run build",
    "verify:quick": "npm run lint && npm run test:ci",
    "desktop:package": "node scripts/desktop-package.mjs",
    "desktop:preflight": "node scripts/desktop-preflight.mjs",
    "desktop:dist": "node scripts/desktop-dist.mjs",
    "db:repair-legacy": "node scripts/repair-legacy-db.mjs",
    "sync": "bash scripts/sync-uploads-and-db.sh",
    "sync:safe": "bash scripts/sync-safe.sh",
    "symphony": "./bin/symphony",
    "setup": "./bin/setup"
  },
  "dependencies": {
    "@deepgram/sdk": "^4.11.3",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/fluent-ffmpeg": "^2.1.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "fluent-ffmpeg": "^2.1.3",
    "https-proxy-agent": "^7.0.6",
    "lucide-react": "^0.563.0",
    "next": "16.2.5",
    "next-intl": "^4.13.3",
    "next-themes": "^0.4.6",
    "openai": "^6.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-fsrs": "^5.2.3",
    "undici": "^7.19.0",
    "uuid": "^13.0.0",
    "wavesurfer.js": "^7.12.1"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "16.2.5",
