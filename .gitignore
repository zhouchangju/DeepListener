# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# project specific
/public/uploads/*
!/public/uploads/.gitkeep
/public/videos/*
!/public/videos/.gitkeep
*.db
*.db-journal
/prisma/*.db.*.backup
*.log

# vendored ffmpeg binaries (keep README + .gitkeep, ignore the large binaries)
/vendor/ffmpeg/ffmpeg
/vendor/ffmpeg/ffprobe
/vendor/ffmpeg/*.exe
/vendor/ffmpeg/*.dylib

# local UI-configured secrets (transcription provider keys etc.)
/settings/secrets.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# git worktrees
.worktrees/
docs/OMSCS
.gstack/

# desktop build artifacts (standalone bundle + dmg + unpacked .app)
.desktop-build/

# disposable Electron feasibility spike (verdict archived under docs/review/;
# production shell lives in desktop/). Kept ignored in case it is rebuilt locally.
desktop-spike/

# nested lockfiles — the root package-lock.json is the source of truth
desktop/package-lock.json

# local AI coding-tool state (not project content)
.reasonix/
.zcode/
