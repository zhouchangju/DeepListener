// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Track {
  id            String     @id @default(uuid())
  title         String
  audioUrl      String
  transcription String     // JSON string storing Whisper word-level data
  note          String?    // User's free-text note for the track
  trackType     String?    // Conversation, Lecture, Other
  trackTopic    String?    // 校园生活, 社会科学, etc.
  isArchived    Boolean    @default(false)
  status        String     @default("UNLEARNT") // UNLEARNT, INTENSIVE, ANALYSIS, SHADOWING, SPEED_SHADOWING, PARAPHRASE, LEARNT
  createdAt     DateTime   @default(now())
  
  sentences     Sentence[]
  categories    TrackCategory[]

  @@index([isArchived])
  @@index([status])
  @@index([createdAt])
}

model Category {
  id    String @id @default(uuid())
  name  String @unique
  tracks TrackCategory[]
}

model TrackCategory {
  trackId    String
  categoryId String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([trackId, categoryId])
}

model Sentence {
  id          String   @id @default(uuid())
  trackId     String
  track       Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  
  text        String
  startTime   Float    // In seconds
  endTime     Float    // In seconds
  orderIndex  Int
  formatting  String?  // JSON string storing phonetic notations

  reviewItem  ReviewItem?
}

model ReviewItem {
  id          String   @id @default(uuid())
  sentenceId  String   @unique
  sentence    Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  level       Int      @default(0) // 当前复习等级 (0-5)
  difficulty  String   @default("NORMAL") // EASY, NORMAL, HARD, VERY_HARD
  nextReview  DateTime @default(now()) // 下次复习时间
  
  tags        ErrorTag[]
  
  userNote    String?
  createdAt   DateTime @default(now())

  logs        ReviewLog[]

  @@index([nextReview])
  @@index([createdAt])
}

model ReviewLog {
  id           String     @id @default(uuid())
  reviewItemId String
  reviewItem   ReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  
  reviewType   String     @default("STANDARD") // STANDARD, BLIND, SHADOWING
  rating       Int        @default(0) // 0-5
  duration     Int        @default(0) // Seconds spent
  createdAt    DateTime   @default(now())
}

model ErrorTag {
  id          String       @id @default(uuid())
  name        String       @unique // "Linking", "Vocab", "Speed", "Grammar", etc.
  reviewItems ReviewItem[]
}