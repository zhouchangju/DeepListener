generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Track {
  id            String          @id @default(uuid())
  title         String
  audioUrl      String
  mediaType     String          @default("AUDIO")
  videoUrl      String?
  transcription String
  note          String?
  trackType     String?
  trackTopic    String?
  isArchived    Boolean         @default(false)
  status        String          @default("UNLEARNT")
  createdAt     DateTime        @default(now())
  sentences     Sentence[]
  categories    TrackCategory[]

  @@index([isArchived])
  @@index([status])
  @@index([createdAt])
}

model Category {
  id     String          @id @default(uuid())
  name   String          @unique
  tracks TrackCategory[]
}

model TrackCategory {
  trackId    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([trackId, categoryId])
}

model Sentence {
  id         String      @id @default(uuid())
  trackId    String
  text       String
  startTime  Float
  endTime    Float
  orderIndex Int
  formatting String?
  reviewItem ReviewItem?
  track      Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model ReviewItem {
  id         String      @id @default(uuid())
  sentenceId String      @unique
  level      Int         @default(0)
  difficulty String      @default("NORMAL")
  stability  Float       @default(0)
  dr         Float       @default(0)
  state      Int         @default(0)
  reps       Int         @default(0)
  lapses     Int         @default(0)
  lastReview DateTime?
  due        DateTime    @default(now())
  retrieval  Int         @default(0)
  lapse      Int         @default(0)
  nextReview DateTime    @default(now())
  isArchived Boolean     @default(false)
  userNote   String?
  createdAt  DateTime    @default(now())
  sentence   Sentence    @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  logs       ReviewLog[]
  tags       ErrorTag[]  @relation("ErrorTagToReviewItem")

  @@index([due])
  @@index([nextReview])
  @@index([createdAt])
  @@index([isArchived])
}

model ReviewLog {
  id           String     @id @default(uuid())
  reviewItemId String
  reviewType   String     @default("STANDARD")
  rating       Int        @default(0)
  duration     Int        @default(0)
  createdAt    DateTime   @default(now())
  reviewItem   ReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
}

model StudySession {
  id        String   @id @default(uuid())
  date      DateTime
  duration  Int
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, type])
}

model ErrorTag {
  id          String       @id @default(uuid())
  name        String       @unique
  reviewItems ReviewItem[] @relation("ErrorTagToReviewItem")
}
