#!/usr/bin/env bash

# Symphony Setup Script
# Based on https://github.com/openai/symphony/blob/main/elixir/README.md

set -euo pipefail

echo "--- Symphony Setup ---"

echo "1. Installing Node.js dependencies..."
npm install

echo "2. Checking local environment configuration..."
if [ -f .env ]; then
  if ! grep -q "LINEAR_API_KEY" .env; then
    echo "Optional: add LINEAR_API_KEY to .env if you plan to use Symphony Linear integration."
  fi
else
  echo "No .env file found. Setup will not create or edit local secret files."
  echo "Create .env manually only when you need provider credentials."
fi

echo "3. Synchronizing database schema..."
export DATABASE_URL="${DATABASE_URL:-file:./dev.db}"
ACTIVE_DB_PATH="prisma/dev.db"

echo "Using DATABASE_URL=${DATABASE_URL}; Prisma resolves the default SQLite file at ${ACTIVE_DB_PATH}."
npx prisma generate

if [ -f "${ACTIVE_DB_PATH}" ]; then
  echo "Existing database found (${ACTIVE_DB_PATH}). Applying pending migrations safely..."
else
  echo "No existing database found at ${ACTIVE_DB_PATH}. Applying existing migrations to initialize it."
fi

if npx prisma migrate deploy; then
  echo "Database schema is up to date."
else
  echo "WARNING: Automatic migration deployment failed. This usually means your local database differs from migration history."
  echo "Resolve the local database state manually before retrying setup."
fi

echo "Setup complete."
